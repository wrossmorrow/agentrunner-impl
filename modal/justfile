set dotenv-load

default:
    @just --list

# Sync Python dependencies (including dev tools)
sync:
    uv sync

# Format code with ruff
fmt:
    uv run ruff format .

# Check formatting with ruff
fmt-check:
    uv run ruff format --check .

# Lint code with ruff
lint:
    uv run ruff check .

# Typecheck Python sources with mypy
typecheck:
    uv run mypy flint_server.py inkling_server.py smoke_test.py

# Compile and verify server imports under flint and inkling configs
verify-imports:
    uv run python -m py_compile flint_server.py inkling_server.py smoke_test.py
    PYTHONPATH=. FLINT_VARIANT=bf16 uv run python -c "import flint_server; print(flint_server.APP_NAME, flint_server.GPU)"
    PYTHONPATH=. FLINT_VARIANT=nvfp4 FLINT_ENABLE_GPU_SNAPSHOT=1 uv run python -c "import flint_server; print(flint_server.APP_NAME, flint_server.GPU, flint_server.ENABLE_GPU_SNAPSHOT)"
    PYTHONPATH=. uv run python -c "import inkling_server; print(inkling_server.APP_NAME, inkling_server.GPU, inkling_server.ENABLE_DSPARK)"
    PYTHONPATH=. INKLING_GPU=B200 INKLING_ENABLE_GPU_SNAPSHOT=1 uv run python -c "import inkling_server; print(inkling_server.APP_NAME, inkling_server.GPU, inkling_server.ENABLE_GPU_SNAPSHOT)"

# Run all code quality and import checks
check: fmt-check lint typecheck verify-imports

# Authenticate local Modal CLI
auth:
    uv run modal setup

# Show current Modal CLI profile
profile:
    uv run modal profile current

# List deployed Modal apps
apps:
    uv run modal app list

# Create or update the Modal secret holding FLINT_API_KEY (falls back to .env FLINT_API_KEY)
secret api_key="":
    #!/usr/bin/env bash
    set -euo pipefail
    key="{{api_key}}"
    if [[ -z "$key" ]]; then
        key="${FLINT_API_KEY:-}"
    fi
    if [[ -z "$key" ]]; then
        echo "Error: pass api_key=... or set FLINT_API_KEY in modal/.env" >&2
        exit 1
    fi
    uv run modal secret create flint-api-key "FLINT_API_KEY=$key" --force

# Pre-download RecursiveSI/flint weights to the persistent Modal volume
download variant="bf16":
    FLINT_VARIANT={{variant}} uv run modal run flint_server.py::download_weights --variant {{variant}}

# Deploy the Modal serverless flint endpoint (variant: bf16 | nvfp4)
deploy variant="bf16" gpu="" snapshot="0":
    FLINT_VARIANT={{variant}} FLINT_GPU={{gpu}} FLINT_ENABLE_GPU_SNAPSHOT={{snapshot}} uv run modal deploy flint_server.py

# Run standalone smoke test against a deployed Modal endpoint (falls back to .env FLINT_VLLM_URL / FLINT_API_KEY)
smoke-test url="" api_key="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "{{url}}" ]]; then export FLINT_VLLM_URL="{{url}}"; fi
    if [[ -n "{{api_key}}" ]]; then export FLINT_API_KEY="{{api_key}}"; fi
    uv run python smoke_test.py

# Tail logs for the deployed Modal flint app
logs variant="bf16":
    uv run modal app logs flint-{{variant}}

# Stop the deployed Modal flint app
stop variant="bf16":
    uv run modal app stop flint-{{variant}}

# Create or update the Modal secret holding INKLING_API_KEY (falls back to .env INKLING_API_KEY)
inkling-secret api_key="":
    #!/usr/bin/env bash
    set -euo pipefail
    key="{{api_key}}"
    if [[ -z "$key" ]]; then
        key="${INKLING_API_KEY:-}"
    fi
    if [[ -z "$key" ]]; then
        echo "Error: pass api_key=... or set INKLING_API_KEY in modal/.env" >&2
        exit 1
    fi
    uv run modal secret create inkling-api-key "INKLING_API_KEY=$key" --force

# Pre-download thinkingmachines/Inkling-2-Mini weights to the persistent Modal volume
inkling-download:
    uv run modal run inkling_server.py::download_weights

# Deploy the Modal serverless Inkling-2-Mini endpoint
inkling-deploy gpu="" snapshot="0" dspark="1":
    INKLING_GPU={{gpu}} INKLING_ENABLE_GPU_SNAPSHOT={{snapshot}} INKLING_ENABLE_DSPARK={{dspark}} uv run modal deploy inkling_server.py

# Run standalone smoke test against the deployed Inkling-2-Mini endpoint
inkling-smoke-test url="" api_key="":
    #!/usr/bin/env bash
    set -euo pipefail
    target_url="{{url}}"
    target_key="{{api_key}}"
    if [[ -z "$target_url" ]]; then
        target_url="${INKLING_URL:-${INKLING_VLLM_URL:-}}"
    fi
    if [[ -z "$target_key" ]]; then
        target_key="${INKLING_API_KEY:-}"
    fi
    if [[ -z "$target_url" || -z "$target_key" ]]; then
        echo "Error: pass url/api_key or set INKLING_URL (or INKLING_VLLM_URL) and INKLING_API_KEY in modal/.env" >&2
        exit 1
    fi
    uv run python smoke_test.py --model thinkingmachines/Inkling-2-Mini --url "$target_url" --api-key "$target_key"

# Tail logs for the deployed Modal Inkling-2-Mini app
inkling-logs:
    uv run modal app logs inkling-2-mini

# Stop the deployed Modal Inkling-2-Mini app
inkling-stop:
    uv run modal app stop inkling-2-mini
